{
  "name": "sanad",
  "version": "1.0.0-alpha.1",
  "description": "سند — منصة العمليات اليومية للامتثال والمحاماة (Sanad Legal Platform)",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev -p 3001 2>&1 | tee dev.log",
    "debug": "NODE_OPTIONS='--inspect' next dev -p 3001 2>&1 | tee debug.log",
    "build": "next build --webpack && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && mkdir -p .next/standalone/prisma && cp -r prisma/. .next/standalone/prisma/",
    "start": "NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "start:pm2": "NODE_ENV=production pm2 start .next/standalone/server.js --name sanad --update-env",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "seed": "npx tsx scripts/seed.ts && npx tsx scripts/seed_student.ts",
    "seed:lawyer": "npx tsx scripts/seed.ts",
    "seed:student": "npx tsx scripts/seed_student.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.0",
    "@mdxeditor/editor": "^4.3.3",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reactuses/core": "^6.6.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.14.0",
    "emailjs": "^5.0.3",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^14.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "otplib": "^13.5.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "uqr": "0.1.3",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "js-yaml": "4.3.2",
    "nanoid": "6.0.1",
    "postcss": "8.5.28",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
