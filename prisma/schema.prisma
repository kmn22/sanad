// Sanad — operational legal/SME dashboard
// Persistent data lives here. UI prefs, timer state, and daily todos
// live in localStorage to keep the home server load minimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  password            String?
  role                String    @default("lawyer") // admin | workspace_owner | lawyer | staff | student | auditor
  workspaceId         String?
  emailVerified       DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  domain         String?  @unique
  subscriptionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  clients        Client[]
  cases          LegalCase[]
  documents      LegalDocument[]
  tasks          Task[]
  invoices       Invoice[]
  compliance     ComplianceItem[]
  timeEntries    TimeEntry[]
  courses        Course[]
  lectures       Lecture[]
  deadlines      AcademicDeadline[]
  legalTerms     LegalTerm[]
  caseEntries    CaseEntry[]
  reviewSessions ReviewSession[]
  researchItems  ResearchItem[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===== Client management (CRM) =====
model Client {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("individual") // individual | corporate
  phone       String?
  email       String?
  nationalId  String? // هوية وطنية أو سجل تجاري
  address     String?
  company     String? // company name if corporate
  notes       String?
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace?      @relation(fields: [workspaceId], references: [id])
  cases          LegalCase[]
  documents      LegalDocument[]
  communications Communication[]
  invoices       Invoice[]

  @@index([workspaceId])
}

// Compliance Tracker — Iqama, CR, employee contracts, licenses
model ComplianceItem {
  id          String   @id @default(cuid())
  title       String
  category    String // iqama | cr | contract | license | tax | gosi
  entityName  String // employee name, company name, etc.
  issueDate   DateTime
  expiryDate  DateTime
  status      String   @default("active") // active | expiring | expired | renewed
  notes       String?
  notifyDays  Int      @default(30)
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([expiryDate])
}

// Case Kanban — Drafting / Client Review / Filed / Closed
model LegalCase {
  id            String    @id @default(cuid())
  title         String
  clientId      String?
  clientName    String // kept for backwards compat / display
  caseType      String // litigation | contract | consultation | ip | corporate
  stage         String    @default("drafting") // drafting | client_review | filed | closed
  priority      String    @default("normal") // low | normal | high | urgent
  dueDate       DateTime?
  hearingDate   DateTime? // next court hearing
  value         Float? // estimated value / billing amount
  caseNumber    String? // رقم القضية في المحكمة
  court         String? // المحكمة
  opposingParty String? // الخصم
  notes         String?
  portalToken   String?   @unique // رابط البوابة السري للعميل
  workspaceId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace      Workspace?      @relation(fields: [workspaceId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries    TimeEntry[]
  communications Communication[]
  invoices       Invoice[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([stage])
  @@index([caseNumber])
}

// Document Lifecycle
model LegalDocument {
  id          String    @id @default(cuid())
  title       String
  docType     String // nda | employment | non_compete | msa | subcontract | policy | pleading | contract_draft | court_filing
  status      String    @default("draft") // draft | sent | active | expiring | expired
  parties     String
  signedDate  DateTime?
  expiryDate  DateTime?
  caseId      String?
  clientId    String?
  notes       String?
  workspaceId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([caseId])
  @@index([clientId])
  @@index([expiryDate])
}

// Tasks — manual and auto-generated from doc lifecycle events
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // todo | in_progress | done
  priority    String    @default("normal") // low | normal | high
  dueDate     DateTime?
  relatedDoc  String? // doc title if auto-generated
  caseId      String?
  autoGen     Boolean   @default(false)
  workspaceId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([caseId])
  @@index([status])
  @@index([dueDate])
}

// Billable hours + focus sessions
model TimeEntry {
  id          String   @id @default(cuid())
  caseId      String?
  description String
  durationSec Int
  billable    Boolean  @default(false)
  hourlyRate  Float?
  invoiced    Boolean  @default(false) // true once attached to an invoice
  invoiceId   String? // link to invoice
  sessionType String   @default("focus") // focus | billable | meeting | break
  date        DateTime @default(now())
  workspaceId String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  case      LegalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  invoice   Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([caseId])
  @@index([invoiceId])
  @@index([date])
}

// Daily Brief — micro feed of MoJ/MHRSD updates
model DailyBrief {
  id          String   @id @default(cuid())
  title       String
  summary     String
  source      String // MoJ | MHRSD | VAT | local_tip
  category    String // regulation | labor | tax | corporate | ip
  url         String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// Research Hub — saved bookmarks, legal precedents, statutes and custom dossiers
model ResearchItem {
  id          String   @id @default(cuid())
  workspaceId String?
  title       String
  content     String
  type        String   @default("statute") // statute | precedent | regulation | note | doctrine
  category    String   @default("general") // commercial | civil | labor | tax | corporate | procedural
  source      String? // statutory citation e.g. "نظام المعاملات المدنية - م/179"
  tags        String? // comma-separated tags e.g. "شرط جزائي, تعويض"
  notes       String? // personal study or case citation notes
  caseId      String? // optional link to a LegalCase
  url         String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([type])
  @@index([category])
}

// ===== Invoicing =====
model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique // INV-2026-001
  clientId    String?
  caseId      String?
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  status      String    @default("draft") // draft | sent | paid | overdue | cancelled
  subtotal    Float     @default(0)
  vatRate     Float     @default(15) // Saudi VAT
  vatAmount   Float     @default(0)
  total       Float     @default(0)
  paidAmount  Float     @default(0)
  paidAt      DateTime?
  notes       String?
  paymentUrl  String?
  zatcaHash   String?
  zatcaXml    String?
  zatcaStatus String    @default("not_submitted") // not_submitted | submitted | valid | rejected
  workspaceId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace?  @relation(fields: [workspaceId], references: [id])
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case        LegalCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([caseId])
  @@index([status])
}

// ===== Communications log =====
model Communication {
  id          String   @id @default(cuid())
  clientId    String?
  caseId      String?
  type        String // call | email | meeting | sms | note
  direction   String   @default("outgoing") // incoming | outgoing
  subject     String
  body        String
  durationMin Int? // for calls/meetings
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  client Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case   LegalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([caseId])
  @@index([date])
}

// ===== Student mode tables =====

model Course {
  id          String   @id @default(cuid())
  workspaceId String?
  title       String
  code        String?
  instructor  String?
  semester    String?
  credits     Int?
  color       String   @default("#0F5132")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace?         @relation(fields: [workspaceId], references: [id])
  lectures  Lecture[]
  deadlines AcademicDeadline[]

  @@index([workspaceId])
}

model Lecture {
  id          String   @id @default(cuid())
  workspaceId String?
  courseId    String
  title       String
  lectureDate DateTime
  topic       String?
  notes       String
  attachments String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([courseId])
}

model AcademicDeadline {
  id          String   @id @default(cuid())
  workspaceId String?
  courseId    String?
  title       String
  type        String
  dueDate     DateTime
  status      String   @default("todo")
  priority    String   @default("normal")
  weight      Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([courseId])
  @@index([dueDate])
}

model LegalTerm {
  id          String   @id @default(cuid())
  workspaceId String?
  term        String
  definition  String
  category    String   @default("general")
  origin      String?
  example     String?
  mastery     String   @default("learning")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, term])
  @@index([workspaceId])
}

model CaseEntry {
  id           String   @id @default(cuid())
  workspaceId  String?
  caseName     String
  citation     String?
  court        String?
  principle    String
  subject      String
  summary      String?
  significance String?
  rating       Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model ReviewSession {
  id            String   @id @default(cuid())
  workspaceId   String?
  mode          String
  sourceType    String
  sourceLabel   String
  cardCount     Int
  correctCount  Int      @default(0)
  reviewedCount Int      @default(0)
  durationSec   Int      @default(0)
  score         Float?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model Invitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String
  role        String    @default("staff")
  workspaceId String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AuthRateLimit {
  id           String    @id @default(cuid())
  key          String    @unique
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

// ===== Phase 3: SaaS & Digital Signatures =====

model Plan {
  id        String   @id @default(cuid())
  name      String // starter | pro | enterprise
  price     Float
  features  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String   @id @default(cuid())
  planId               String
  status               String   @default("active") // active | past_due | canceled
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plan       Plan        @relation(fields: [planId], references: [id])
  workspaces Workspace[]

  @@index([planId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model DocumentSignature {
  id          String    @id @default(cuid())
  documentId  String
  signerName  String
  signerId    String // National ID for Nafath
  status      String    @default("pending") // pending | signed | rejected
  nafathReqId String? // Nafath request reference
  signedAt    DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([documentId])
}
