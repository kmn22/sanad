// Sanad — operational legal/SME dashboard
// Persistent data lives here. UI prefs, timer state, and daily todos
// live in localStorage to keep the home server load minimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  password             String?
  role                 String    @default("lawyer") // admin | workspace_owner | lawyer | staff | student | auditor | client
  workspaceId          String?
  // Set only for role=client: the Client record this login represents.
  // Client users must never be authorised by workspaceId alone.
  clientId             String?
  accountType          String? // student | lawyer | firm — chosen at self-registration
  emailVerified        DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  passwordChangedAt    DateTime?
  disabledAt           DateTime?
  sessionVersion       Int       @default(0)
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?
  mfaRecoveryCodes     String?
  privacyNoticeVersion String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace        Workspace?       @relation(fields: [workspaceId], references: [id])
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  notifications    Notification[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  caseAssignments        CaseAssignment[]
  workflowEvents         WorkflowEvent[]
  assignedPortalRequests PortalRequest[]
  memberships           WorkspaceMembership[]
  notificationPreferences NotificationPreference[]
  requestedApprovals    Approval[]          @relation("ApprovalRequester")
  assignedApprovals     Approval[]          @relation("ApprovalApprover")
  documentVersions      DocumentVersion[]
  documentSignatures    DocumentSignature[]

  @@index([workspaceId])
  @@index([clientId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("firm") // solo | firm | academic
  domain         String?  @unique
  subscriptionId   String?
  status           String   @default("active") // active | suspended | archived
  onboardingStatus String   @default("pending") // pending | in_progress | completed
  ownerId          String?
  suspendedAt      DateTime?
  suspensionReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  clients        Client[]
  cases          LegalCase[]
  documents      LegalDocument[]
  tasks          Task[]
  invoices       Invoice[]
  compliance     ComplianceItem[]
  timeEntries    TimeEntry[]
  communications Communication[]
  courses        Course[]
  lectures       Lecture[]
  deadlines      AcademicDeadline[]
  legalTerms     LegalTerm[]
  caseEntries    CaseEntry[]
  reviewSessions ReviewSession[]
  researchItems   ResearchItem[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  caseAssignments CaseAssignment[]
  workflowEvents  WorkflowEvent[]
  portalAccesses  PortalAccess[]
  portalRequests  PortalRequest[]
  portalFiles       PortalFile[]
  memberships       WorkspaceMembership[]
  usageMetrics      UsageMetric[]
  featureFlags      FeatureFlag[]
  backgroundJobs    BackgroundJob[]
  workflowTemplates WorkflowTemplate[]
  approvals         Approval[]
  documentVersions  DocumentVersion[]
  documentSignatures DocumentSignature[]
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id])
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  status      String    @default("active") // invited | active | suspended | left
  isOwner     Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
}

model UsageMetric {
  id          String   @id @default(cuid())
  workspaceId String
  metric      String // seats | storage_bytes | ai_requests | portal_uploads | emails
  period      String // YYYY-MM
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, period])
  @@index([workspaceId, period])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  enabled     Boolean  @default(false)
  value       String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  workspaceId String?
  type        String
  payload     String
  status      String    @default("queued") // queued | processing | completed | failed | cancelled
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workspaceId, createdAt])
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String
  type        String
  inApp       Boolean  @default(true)
  email       Boolean  @default(true)
  quietStart  String?
  quietEnd    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  actorId     String?
  type        String   @default("system") // system | assignment | workflow | portal | security
  title       String
  message     String
  isRead      Boolean  @default(false)
  link        String?
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ===== Client management (CRM) =====
model Client {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("individual") // individual | corporate
  phone       String?
  email       String?
  nationalId  String? // هوية وطنية أو سجل تجاري
  address     String?
  company     String? // company name if corporate
  notes       String?
  deletedAt   DateTime? // soft-delete — retention sweep purges after policy
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  cases          LegalCase[]
  documents      LegalDocument[]
  communications Communication[]
  invoices       Invoice[]
  portalAccesses PortalAccess[]
  portalRequests PortalRequest[]
  portalFiles    PortalFile[]
  users          User[]

  @@index([workspaceId])
}

// Compliance Tracker — Iqama, CR, employee contracts, licenses
model ComplianceItem {
  id          String    @id @default(cuid())
  title       String
  category    String // iqama | cr | contract | license | tax | gosi
  entityName  String // employee name, company name, etc.
  issueDate   DateTime
  expiryDate  DateTime
  status      String    @default("active") // active | expiring | expired | renewed
  notes       String?
  notifyDays  Int       @default(30)
  deletedAt   DateTime?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([expiryDate])
}

// Case Kanban — Drafting / Client Review / Filed / Closed
model LegalCase {
  id            String    @id @default(cuid())
  title         String
  clientId      String?
  clientName    String // kept for backwards compat / display
  caseType      String // litigation | contract | consultation | ip | corporate
  stage         String    @default("drafting") // drafting | client_review | filed | closed
  priority      String    @default("normal") // low | normal | high | urgent
  dueDate       DateTime?
  hearingDate   DateTime? // next court hearing
  value         Decimal? @db.Decimal(14, 2) // estimated value / billing amount
  caseNumber    String? // رقم القضية في المحكمة
  court         String? // المحكمة
  opposingParty String? // الخصم
  notes         String?
  // Confidential matters are visible only to owners/admins and assigned
  // members — see canAccessCase in lib/auth/capabilities.
  confidential  Boolean   @default(false)
  deletedAt     DateTime?
  templateId    String?
  workspaceId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id])
  template       WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  approvals      Approval[]
  timeEntries    TimeEntry[]
  tasks          Task[]
  documents      LegalDocument[]
  communications Communication[]
  invoices       Invoice[]
  assignments    CaseAssignment[]
  workflowEvents WorkflowEvent[]
  portalAccesses PortalAccess[]
  portalRequests PortalRequest[]
  portalFiles    PortalFile[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([stage])
  @@index([caseNumber])
  @@index([templateId])
  @@index([confidential])
  @@index([deletedAt])
}

// Document Lifecycle
model LegalDocument {
  id          String    @id @default(cuid())
  title       String
  docType     String // nda | employment | non_compete | msa | subcontract | policy | pleading | contract_draft | court_filing
  status      String    @default("draft") // draft | sent | active | expiring | expired
  parties     String
  signedDate  DateTime?
  expiryDate  DateTime?
  caseId      String?
  clientId    String?
  notes        String?
  fileKey      String? // encrypted storage key under UPLOAD_ROOT
  mimeType     String?
  sizeBytes    Int?
  checksumSha256 String?
  uploadedBy   String? // user | client_portal | system
  visibility   String    @default("internal") // internal | client
  deletedAt    DateTime?
  workspaceId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case        LegalCase?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  portalFiles PortalFile[]
  versions    DocumentVersion[]
  approvals   Approval[]

  @@index([workspaceId])
  @@index([caseId])
  @@index([clientId])
  @@index([expiryDate])
  @@index([visibility])
}

// Configurable case workflow templates — ordered stage pipelines per case type
model WorkflowTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  caseType    String? // null = applies to every case type
  stages      String // JSON array of ordered stage keys from CASE_STAGES
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  cases     LegalCase[]

  @@index([workspaceId])
  @@index([workspaceId, active])
}

// Approval chains — document, case, or task sign-off requests
model Approval {
  id            String    @id @default(cuid())
  workspaceId   String
  caseId        String?
  documentId    String?
  taskId        String?
  title         String
  details       String?
  requestedById String
  approverId    String
  status        String    @default("pending") // pending | approved | rejected | cancelled
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  case      LegalCase?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document  LegalDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approver   User         @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([approverId, status])
  @@index([caseId])
  @@index([documentId])
}

// Immutable document version history — every stored revision of a file
model DocumentVersion {
  id             String   @id @default(cuid())
  workspaceId    String
  documentId     String
  version        Int
  fileKey        String
  originalName   String?
  mimeType       String?
  sizeBytes      Int?
  checksumSha256 String?
  uploadedById   String?
  note           String?
  createdAt      DateTime @default(now())

  workspace  Workspace     @relation(fields: [workspaceId], references: [id])
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([workspaceId])
}

// Tasks — manual and auto-generated from doc lifecycle events
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // todo | in_progress | done
  priority    String    @default("normal") // low | normal | high
  dueDate     DateTime?
  relatedDoc  String? // doc title if auto-generated
  caseId       String?
  assignedToId String?
  autoGen      Boolean   @default(false)
  deletedAt    DateTime?
  workspaceId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  case       LegalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedTo User?      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  events     WorkflowEvent[]
  approvals  Approval[]

  @@index([workspaceId])
  @@index([caseId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

// Team workflow — case ownership and auditable transitions
model CaseAssignment {
  id           String   @id @default(cuid())
  workspaceId  String
  caseId       String
  userId       String
  assignedById String
  role         String   @default("assignee") // lead | assignee | reviewer | observer
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  case      LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkflowEvent {
  id          String   @id @default(cuid())
  workspaceId String
  caseId      String?
  taskId      String?
  actorId     String?
  action      String // assign | unassign | stage_change | task_update | portal_request | client_upload
  fromState   String?
  toState     String?
  note        String?
  metadata    String? // JSON string, no secrets
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  case      LegalCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([caseId])
  @@index([taskId])
  @@index([createdAt])
}

// Secure client portal — hashed, expiring, revocable case/client links
model PortalAccess {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String
  caseId         String?
  tokenHash      String    @unique
  label          String?
  allowUpload    Boolean   @default(true)
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case      LegalCase?      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requests  PortalRequest[]
  files     PortalFile[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([caseId])
  @@index([expiresAt])
}

model PortalRequest {
  id             String    @id @default(cuid())
  workspaceId    String
  portalAccessId String
  clientId       String
  caseId         String?
  assignedToId   String?
  createdBy      String // portal | user
  title          String
  message        String
  status         String   @default("open") // open | answered | closed
  priority       String   @default("normal") // low | normal | high | urgent
  dueDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  portalAccess PortalAccess   @relation(fields: [portalAccessId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         LegalCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedTo   User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  files        PortalFile[]

  @@index([workspaceId])
  @@index([portalAccessId])
  @@index([clientId])
  @@index([caseId])
  @@index([status])
}

model PortalFile {
  id             String   @id @default(cuid())
  workspaceId    String
  portalAccessId String
  requestId      String?
  documentId     String?
  clientId       String
  caseId         String?
  fileKey        String // encrypted object key under UPLOAD_ROOT
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  status         String   @default("stored") // stored | linked | quarantined | deleted
  createdAt      DateTime @default(now())

  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  portalAccess PortalAccess   @relation(fields: [portalAccessId], references: [id], onDelete: Cascade)
  request      PortalRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  document     LegalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case         LegalCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([portalAccessId])
  @@index([requestId])
  @@index([clientId])
  @@index([caseId])
}

// Billable hours + focus sessions
model TimeEntry {
  id          String   @id @default(cuid())
  caseId      String?
  description String
  durationSec Int
  billable    Boolean  @default(false)
  hourlyRate  Decimal? @db.Decimal(10, 2)
  invoiced    Boolean  @default(false) // true once attached to an invoice
  invoiceId   String? // link to invoice
  sessionType String   @default("focus") // focus | billable | meeting | break
  date        DateTime @default(now())
  deletedAt   DateTime?
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  case      LegalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  invoice   Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([caseId])
  @@index([invoiceId])
  @@index([date])
}

// Daily Brief — micro feed of MoJ/MHRSD updates
model DailyBrief {
  id          String   @id @default(cuid())
  title       String
  summary     String
  source      String // MoJ | MHRSD | VAT | local_tip
  category    String // regulation | labor | tax | corporate | ip
  url         String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// Research Hub — saved bookmarks, legal precedents, statutes and custom dossiers
model ResearchItem {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String
  type        String   @default("statute") // statute | precedent | regulation | note | doctrine
  category    String   @default("general") // commercial | civil | labor | tax | corporate | procedural
  source      String? // statutory citation e.g. "نظام المعاملات المدنية - م/179"
  tags        String? // comma-separated tags e.g. "شرط جزائي, تعويض"
  notes       String? // personal study or case citation notes
  caseId      String? // optional link to a LegalCase
  url         String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([type])
  @@index([category])
}

// ===== Invoicing =====
model Invoice {
  id          String    @id @default(cuid())
  number      String // unique per workspace — INV-2026-001
  clientId    String?
  caseId      String?
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  status      String    @default("draft") // draft | sent | paid | overdue | cancelled
  subtotal    Decimal   @default(0) @db.Decimal(14, 2)
  vatRate     Decimal   @default(15) @db.Decimal(5, 2) // Saudi VAT
  vatAmount   Decimal   @default(0) @db.Decimal(14, 2)
  total       Decimal   @default(0) @db.Decimal(14, 2)
  paidAmount  Decimal   @default(0) @db.Decimal(14, 2)
  paidAt      DateTime?
  notes       String?
  paymentUrl  String?
  zatcaHash   String?
  zatcaXml    String?
  zatcaStatus String    @default("not_submitted") // not_submitted | preview | submitted | valid | rejected
  deletedAt   DateTime?
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case        LegalCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@unique([workspaceId, number])
  @@index([workspaceId])
  @@index([clientId])
  @@index([caseId])
  @@index([status])
  @@index([deletedAt])
}

// ===== Communications log =====
model Communication {
  id          String   @id @default(cuid())
  clientId    String?
  caseId      String?
  workspaceId String
  type        String // call | email | meeting | sms | note
  direction   String   @default("outgoing") // incoming | outgoing
  subject     String
  body        String
  durationMin Int? // for calls/meetings
  date        DateTime @default(now())
  deletedAt   DateTime?
  createdAt   DateTime @default(now())

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case      LegalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  workspace Workspace  @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([clientId])
  @@index([caseId])
  @@index([date])
}

// ===== Student mode tables =====

model Course {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  code        String?
  instructor  String?
  semester    String?
  credits     Int?
  color       String   @default("#0F5132")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id])
  lectures  Lecture[]
  deadlines AcademicDeadline[]

  @@index([workspaceId])
}

model Lecture {
  id          String   @id @default(cuid())
  workspaceId String
  courseId    String
  title       String
  lectureDate DateTime
  topic       String?
  notes       String
  attachments String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([courseId])
}

model AcademicDeadline {
  id          String   @id @default(cuid())
  workspaceId String
  courseId    String?
  title       String
  type        String
  dueDate     DateTime
  status      String   @default("todo")
  priority    String   @default("normal")
  weight      Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([courseId])
  @@index([dueDate])
}

model LegalTerm {
  id          String   @id @default(cuid())
  workspaceId String
  term        String
  definition  String
  category    String   @default("general")
  origin      String?
  example     String?
  mastery     String   @default("learning")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, term])
  @@index([workspaceId])
}

model CaseEntry {
  id           String   @id @default(cuid())
  workspaceId  String
  caseName     String
  citation     String?
  court        String?
  principle    String
  subject      String
  summary      String?
  significance String?
  rating       Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model ReviewSession {
  id            String   @id @default(cuid())
  workspaceId   String
  mode          String
  sourceType    String
  sourceLabel   String
  cardCount     Int
  correctCount  Int      @default(0)
  reviewedCount Int      @default(0)
  durationSec   Int      @default(0)
  score         Float?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model Invitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String
  role        String    @default("staff")
  workspaceId String
  clientId    String? // set for role=client invitations
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AuthRateLimit {
  id           String    @id @default(cuid())
  key          String    @unique
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

model DocumentSignature {
  id              String   @id @default(cuid())
  workspaceId     String
  userId          String?
  documentId      String
  operation       String   // download | export | print
  checksumSha256  String
  signature       String   @unique
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([documentId, createdAt])
}

// ===== Phase 3: SaaS & Digital Signatures =====

model Plan {
  id               String   @id @default(cuid())
  code             String   @unique // trial | starter | professional | enterprise
  name             String
  price             Decimal  @db.Decimal(12, 2)
  billingInterval   String   @default("month")
  seatLimit         Int      @default(3)
  storageLimitMb    Int      @default(1024)
  aiRequestLimit    Int      @default(100)
  portalUploadLimit Int      @default(100)
  features          String // JSON entitlement map
  // Stripe Price (price_...) backing paid checkout; null = not purchasable
  stripePriceId     String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String   @id @default(cuid())
  planId               String
  status               String   @default("trialing") // trialing | active | past_due | suspended | canceled
  quantity             Int      @default(1)
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  currentPeriodEnd     DateTime
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plan       Plan        @relation(fields: [planId], references: [id])
  workspaces Workspace[]

  @@index([planId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model PrivacyNotice {
  id          String    @id @default(cuid())
  version     String
  locale      String
  contentHash String
  publishedAt DateTime  @default(now())
  retiredAt   DateTime?

  @@unique([version, locale])
  @@index([publishedAt])
}

model PrivacyAcceptance {
  id         String   @id @default(cuid())
  userId     String
  noticeId   String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@unique([userId, noticeId])
  @@index([userId])
}

model ConsentRecord {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String?
  purpose       String
  status        String    @default("granted")
  noticeVersion String
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  evidence      String?

  @@index([userId])
  @@index([workspaceId])
  @@index([purpose])
}

model DataSubjectRequest {
  id               String    @id @default(cuid())
  workspaceId      String?
  userId           String?
  requesterEmail   String
  requestType      String
  details          String?
  status           String    @default("received")
  identityVerified Boolean   @default(false)
  receivedAt       DateTime  @default(now())
  dueAt            DateTime
  extendedDueAt    DateTime?
  completedAt      DateTime?
  assignedToId     String?
  responseNotes    String?
  rejectionReason  String?

  @@index([workspaceId])
  @@index([requesterEmail])
  @@index([status, dueAt])
}

model RetentionPolicy {
  id            String   @id @default(cuid())
  workspaceId   String
  entityType    String
  retentionDays Int
  legalBasis    String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, entityType])
}

model LegalHold {
  id           String    @id @default(cuid())
  workspaceId  String
  entityType   String
  entityId     String
  reason       String
  createdById  String
  createdAt    DateTime  @default(now())
  releasedAt   DateTime?
  releasedById String?

  @@index([workspaceId])
  @@index([entityType, entityId])
}

model PrivacyIncident {
  id                  String    @id @default(cuid())
  workspaceId         String?
  title               String
  description         String
  severity            String
  status              String    @default("investigating")
  detectedAt          DateTime
  awareAt             DateTime
  authorityDueAt      DateTime
  authorityNotifiedAt DateTime?
  subjectsNotifiedAt  DateTime?
  affectedSubjects    Int?
  dataCategories      String?
  riskAssessment      String?
  containmentActions  String?
  correctiveActions   String?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status, authorityDueAt])
}

model ProcessorRegister {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  purpose            String
  dataCategories     String
  processingLocation String
  contractReference  String?
  securityReviewAt   DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId])
}

model TransferAssessment {
  id                 String    @id @default(cuid())
  workspaceId        String
  processorId        String?
  destinationCountry String
  purpose            String
  dataCategories     String
  safeguard          String
  riskAssessment     String
  approvedById       String?
  approvedAt         DateTime?
  nextReviewAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId])
}

model DataProtectionImpactAssessment {
  id           String    @id @default(cuid())
  workspaceId  String
  title        String
  processing   String
  necessity    String
  risks        String
  mitigations  String
  residualRisk String
  status       String    @default("draft")
  approvedById String?
  approvedAt   DateTime?
  nextReviewAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
}

model DataAccessEvent {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  entityType  String
  entityId    String
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model BillingWebhookEvent {
  id          String    @id
  type        String
  livemode    Boolean
  status      String    @default("processing")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([status])
}

// Digital-signing requests will be modeled when a real signing provider is
// integrated — the previous standalone DocumentSignature table had no
// workspace scope or document relation and has been removed.

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  interest  String?  @default("general")
  source    String?  @default("landing")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
