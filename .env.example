# Database configuration (SQLite for local/SaaS, or PostgreSQL for cloud scaling)
DATABASE_URL="file:./db/custom.db"

# Server Port
PORT=3001

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"
NEXTAUTH_URL="https://your-domain.com"

# Optional: AI Model Configuration (Defaults to local Ollama or built-in templates)
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OPENAI_API_KEY=""

# Optional: Saudi Regulatory Sync & ZATCA Integration
# NAJIZ_SYNC_ENABLED="true"
# ZATCA_ENV="simulation" # simulation | production
