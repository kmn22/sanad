# Database configuration (SQLite).
# For the Prisma CLI this is resolved relative to prisma/, so file:./db/custom.db
# means prisma/db/custom.db on disk.
# For the Docker runtime use an absolute path: file:/app/db/custom.db
DATABASE_URL="file:./db/custom.db"

# Server Port
PORT=3001

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"
NEXTAUTH_URL="https://your-domain.com"

# Optional: AI Model Configuration (defaults to local Ollama or built-in templates)
OLLAMA_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen2.5:14b"

# Optional: Stripe-style billing webhook secret (required in production)
STRIPE_WEBHOOK_SECRET=""

# Optional: Saudi Regulatory Sync & ZATCA Integration
NAJIZ_SYNC_ENABLED="false"
ZATCA_ENV="simulation" # simulation | production
