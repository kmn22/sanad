# ============================================================================
# Maqar (مقر) — Unified Legal Operations & Governance SaaS Platform
# Runtime & Build Environment Configuration (`.env.example`)
# ============================================================================

# ─── 1. PostgreSQL & Vector Store Configuration ─────────────────────────────
POSTGRES_PASSWORD="generate-a-long-random-password"
DATABASE_URL="postgresql://maqar:${POSTGRES_PASSWORD}@localhost:5432/maqar"
# Optional dedicated pgvector / Supabase Vector connection string for statutory RAG
VECTOR_DATABASE_URL="postgresql://maqar:${POSTGRES_PASSWORD}@localhost:5432/maqar"
# Optional Redis queue broker URL (defaults to PostgreSQL BackgroundJob worker queue)
REDIS_URL=""

# ─── 2. Server Runtime & NextAuth Authentication ────────────────────────────
NODE_ENV="production"
PORT=3001
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"
NEXTAUTH_URL="https://your-domain.com"

# Comma-separated allowlist of platform operator emails permitted cross-tenant access
PLATFORM_ADMIN_EMAILS="ops@maqar.sa"

# ─── 3. Cryptographic Keys & Sovereign Legal Vault Security (PDPL / CCC-2) ──
BACKUP_ENCRYPTION_KEY="generate-a-long-random-secret"
MFA_ENCRYPTION_KEY="generate-a-64-character-hex-key"
FILE_ENCRYPTION_KEY="generate-a-separate-long-random-secret"
DOCUMENT_SIGNATURE_KEY="generate-a-separate-long-random-secret"
# Envelope Encryption Master Root Key for Legal Vaults (`src/lib/security/vault-envelope-encryption.ts`)
VAULT_MASTER_KMS_KEY="generate-a-separate-256-bit-kms-master-secret"
# Immutable WORM Digital Audit Log HMAC-SHA256 Chain Secret (`src/lib/security/immutable-audit-log.ts`)
AUDIT_LOG_HMAC_SECRET="generate-a-separate-long-random-audit-hmac-secret"
UPLOAD_ROOT="/app/uploads"

# ─── 4. Transactional SMTP Email ────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Maqar <no-reply@maqar.sa>"

# ─── 5. AI & Statutory RAG Engine (`src/lib/ai/maqar-rag-pipeline.ts`) ──────
# Local Ollama LLM configuration (defaults to local Ollama or grounded statutory templates)
OLLAMA_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen3-coder:30b"
# Host-side Ollama URL used by scripts/warm-ai.sh (runs outside Docker)
OLLAMA_HOST_URL="http://127.0.0.1:11434"

# OpenAI Embeddings (`text-embedding-3-small`) & Live LLM Toggle
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
MAQAR_USE_OPENAI_EMBEDDINGS="false"
MAQAR_ENABLE_LIVE_LLM="false"

# ─── 6. Automated Multi-Channel Procedural Notifications & Webhooks ─────────
# Protects /api/cron/* for external schedulers (internal job worker also runs on boot)
CRON_SECRET="generate-a-long-random-cron-secret"
WHATSAPP_BUSINESS_API_URL="https://graph.facebook.com/v20.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_ACCESS_TOKEN=""
SMS_PROVIDER_API_URL="https://el.cloud.unifonic.com/rest/SMS/messages"
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="MAQAR"
TRANSACTIONAL_EMAIL_WEBHOOK_URL=""
TRANSACTIONAL_EMAIL_API_KEY=""
# Litigation deadline engine webhook (`src/lib/litigation/deadline-engine.ts`)
MAQAR_MESSAGING_WEBHOOK_URL=""
# Shared secret for the Najiz sync webhook (`/api/sync/najiz`)
NAJIZ_WEBHOOK_SECRET=""

# ─── 7. E-Signature Dispatch & Cryptographic Audit Trail (`src/services/esignature.ts`)
ESIGNATURE_SIGNING_SECRET="generate-a-long-random-hmac-signing-secret"
NAFATH_SIGN_API_URL="https://nafath.api.elm.sa/v1/sign"
NAFATH_CLIENT_ID=""
DOCUSIGN_BASE_URL="https://demo.docusign.net/restapi"
DOCUSIGN_INTEGRATION_KEY=""

# ─── 8. ZATCA Fatoora Phase-2 & Stripe Billing (`src/services/billing.ts`) ──
ZATCA_ENVIRONMENT="sandbox"
ZATCA_API_BASE_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"
ZATCA_SELLER_VAT_NUMBER="300000000000003"
ZATCA_CSID_PUBLIC_KEY=""
ZATCA_CSID_PRIVATE_KEY=""
ENABLE_DEMO_ZATCA="false"

# Optional: Stripe subscription billing (both are required before enabling Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── 9. Public Beta Guard Rails & Feature Flags (0 = disabled) ──────────────
BETA_MAX_WORKSPACES=25
BETA_AI_DAILY_LIMIT=150
ENABLE_DEMO_PORTAL="false"

# ─── 10. Observability, Backups & Networking ────────────────────────────────
SENTRY_DSN=""
TS_AUTHKEY=""
# S3_BACKUP_BUCKET=""
# S3_ENDPOINT_URL=""
# BACKUP_OFFLOAD_CMD='rclone copyto "%f" remote:maqar-backups/%b'
# BACKUP_SUCCESS_URL=""
# DRILL_SUCCESS_URL=""

# ─── 11. Non-Production / E2E / Seeding Guard Variables (Never enable in Prod)
MAQAR_ALLOW_DESTRUCTIVE_SEED="0"
SEED_WORKSPACE_ID=""
E2E_BASE_URL="http://127.0.0.1:3001"
E2E_OWNER_EMAIL="e2e.owner@maqar.test"
E2E_OWNER_PASSWORD="Maqar-E2E-Passw0rd!"
E2E_LAWYER_EMAIL="e2e.lawyer@maqar.test"
E2E_ADMIN_EMAIL="e2e.admin@maqar.test"
E2E_ADMIN_PASSWORD="Maqar-E2E-Passw0rd!"
E2E_ADMIN_MFA_SECRET="JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"
