# PostgreSQL configuration
POSTGRES_PASSWORD="generate-a-long-random-password"
DATABASE_URL="postgresql://sanad:${POSTGRES_PASSWORD}@localhost:5432/sanad"

# Server Port
PORT=3001

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"
NEXTAUTH_URL="https://your-domain.com"

# Transactional email (required for invitations, verification, and password reset)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Sanad <no-reply@your-domain.com>"

# Optional: AI Model Configuration (defaults to local Ollama or built-in templates)
OLLAMA_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen2.5:14b"

# Optional: Stripe billing (both are required before enabling billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Encrypted PostgreSQL backups
BACKUP_ENCRYPTION_KEY="generate-a-long-random-secret"
MFA_ENCRYPTION_KEY="generate-a-64-character-hex-key"
FILE_ENCRYPTION_KEY="generate-a-separate-long-random-secret"
UPLOAD_ROOT="/app/uploads"

# Protects /api/cron/* for external schedulers (the app also runs an internal
# job worker on boot, so this is only needed for external cron callers).
CRON_SECRET="generate-a-long-random-cron-secret"
# S3_BACKUP_BUCKET=""
# S3_ENDPOINT_URL=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_DEFAULT_REGION="us-east-1"

# Optional: shared secret for the Najiz sync webhook (/api/sync/najiz).
# Leave empty to rely on workspace admin authentication only.
NAJIZ_WEBHOOK_SECRET=""
